{
  "expo": {
    "name": "BooQuip",
    "slug": "booquip",
    "scheme": "booquip",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "BooQuip uses your photo library so you can upload a screenshot of a post to reply to."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
{
  "expo": {
    "name": "BooQuip",
    "slug": "booquip",
    "scheme": "booquip",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDFBF7",
    "ios": {
      "bundleIdentifier": "app.booquip.mobile",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.booquip.mobile",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "66f9479e-4e68-44b2-a6a9-ec435f7fbf99"
      }
    },
    "owner": "provenri"
  }
}
